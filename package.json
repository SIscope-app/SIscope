{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prebuild": "tsx scripts/build-api.ts",
    "typecheck": "tsc --noEmit",
    "data": "bash data-pipeline/run_all.sh",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "data:refresh": "bash scripts/data-refresh.sh",
    "test": "node --test scripts/schedule-gate.test.mjs && tsx --test lib/freshness.test.ts lib/present.test.ts && python3 -m unittest discover -s data-pipeline -p 'test_*.py' && bash scripts/data-refresh.test.sh && tsx scripts/build-api.ts && node scripts/check-generated-api.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "16.4.5",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.157.0"
  }
}
